[Unit]
Description=Publish native WireGuard names and secret-free transfer statistics for WG Deck
Documentation=man:wg-quick(8)
After=local-fs.target
RequiresMountsFor=/etc/wireguard

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/wg-deck-inventory
User=root
Group=root
UMask=0022
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/etc/wireguard
ReadWritePaths=/run
CapabilityBoundingSet=CAP_CHOWN CAP_NET_ADMIN
RestrictAddressFamilies=AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
